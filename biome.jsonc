{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/build",
      "!bun.lock",
      "!skills-lock.json",
      // Drizzle-generated SQL and snapshots — regenerated by db:generate, never hand-edited.
      "!packages/db/drizzle",
      "!datasets",
      "!storage",
      "!backups",
      "!seed/qa.jsonl"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // Matches the width the codebase was already hand-wrapped to.
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": { "indentWidth": 2, "lineWidth": 100 }
  },
  "css": {
    "linter": { "enabled": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error",
        // console.error/warn stay available for genuine failure paths; everything else
        // goes through lib/logger.ts so output is structured and filterable.
        "noConsole": { "level": "error", "options": { "allow": ["error", "warn"] } },
        // Tailwind v4 at-rules (@theme, @utility, @source, @custom-variant, @apply) are
        // not in Biome's CSS dialect. Turning this on would flag the entire theme file.
        "noUnknownAtRules": "off",
        // Chat and review render append-only message lists that have no stable row id yet.
        // Index keys are correct for append-only data; revisit if rows become reorderable.
        "noArrayIndexKey": "off"
      },
      "style": {
        "useConst": "error",
        "useImportType": "error",
        // Paired with tsconfig's noUncheckedIndexedAccess, `arr[0]!` after an explicit
        // length check is the idiomatic narrowing. Banning it pushes callers toward
        // weaker workarounds (casts, non-null defaults) that hide more than they fix.
        "noNonNullAssertion": "off"
      },
      "correctness": {
        // Only the missing-dependency half of this rule catches real bugs. The
        // "unnecessary dependency" half fires on deliberately-listed useCallback
        // identities, where an extra re-run is correct and removing the dep is the bug.
        "useExhaustiveDependencies": {
          "level": "error",
          "options": { "reportUnnecessaryDependencies": false }
        },
        // Studio forms are singletons per route — a literal id paired with htmlFor is
        // correct HTML here, and useId() would only obscure the association.
        "useUniqueElementIds": "off"
      }
    }
  },
  "overrides": [
    {
      // CLI entrypoints and the logger itself: stdout IS the interface.
      "includes": [
        "services/rag-api/src/lib/logger.ts",
        "scripts/**",
        "seed/**",
        "templates/**",
        "packages/db/src/scripts/**"
      ],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    }
  ]
}

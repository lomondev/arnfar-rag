# deps
node_modules/
.pnp
.pnp.js

# build output
dist/
build/
.next/
out/
*.tsbuildinfo

# env
.env
.env.local
.env.*.local
!.env.example

# runtime / data
storage/originals/*
!storage/originals/.gitkeep
pgdata/
backups/

# python
__pycache__/
*.pyc

# datasets: track manifests via git-lfs, ignore local scratch exports
datasets/**/*.jsonl.tmp
# stray outputs written when rag-api ran with cwd=services/rag-api (paths were cwd-relative;
# fixed via repoRoot(), kept ignored so old strays can't be committed)
services/*/datasets/
services/*/storage/

# dev.sh process logs + pids
.logs/
.run/

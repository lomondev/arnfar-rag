# ─────────────────────────────────────────────────────────────
# Arnfar AI — environment. Copy to .env and fill in.
# NO secrets are committed. .env is gitignored.
# ─────────────────────────────────────────────────────────────

# ── Postgres 16 + pgvector ≥ 0.8 ──────────────────────────────
POSTGRES_USER=arnfar
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=arnfar
POSTGRES_HOST=localhost
# If the host already runs a native Postgres on 5432, use 5433 here (and in DATABASE_URL).
POSTGRES_PORT=5432
# Consumed by rag-api (Bun) running on the HOST, talking to the container.
DATABASE_URL=postgres://arnfar:change-me-locally@localhost:5432/arnfar

# ── Ollama (runs on the HOST, never called from Next.js) ──────
OLLAMA_BASE_URL=http://localhost:11434
# SEA-LION (Gemma-based, SE-Asian-tuned) is the Lao generator; qwen3 is the
# cross-family judge for eval. Both must be pulled with `ollama pull`.
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_GEN_MODEL=hf.co/aisingapore/Gemma-SEA-LION-v3-9B-IT-GGUF:latest
OLLAMA_GEN_MODEL_ALT=qwen3:8b
# Cap embedding concurrency so the ingest path never starves the chat path.
OLLAMA_EMBED_CONCURRENCY=4

# ── Python sidecars (containerized, :7731 / :7732) ────────────
LAO_NLP_URL=http://localhost:7731
DOCX_EXTRACTOR_URL=http://localhost:7732

# ── rag-api (Bun + Elysia) ────────────────────────────────────
RAG_API_PORT=7730
RAG_API_URL=http://localhost:7730

# ── Object storage (Phase 0 decision: local filesystem volume) ─
# Swappable to S3/MinIO later behind the storage interface.
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./storage

# ── Web (Next.js 15) ──────────────────────────────────────────
# The browser talks ONLY to rag-api. Never to Ollama or the sidecars.
NEXT_PUBLIC_RAG_API_URL=http://localhost:7730

# ── Dev tenant (single-tenant seed; columns/filters exist everywhere) ─
# UUIDv7 values. Regenerate for your own environment.
DEV_HF_ID=018f9a1e-7c00-7000-8000-000000000001
DEV_COMPANY_ID=018f9a1e-7c00-7000-8000-000000000002
DEV_BRANCH_ID=018f9a1e-7c00-7000-8000-000000000003

# Real ERP database (read-only role; see docs/ERP-INTEGRATION.md).
# Unset = bundled demo data.
# ERP_DATABASE_URL=postgres://arnfar_ai:password@erp-host:5432/your_erp_db

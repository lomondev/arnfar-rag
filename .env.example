# ─────────────────────────────────────────────────────────────
# Arnfar AI — environment. Copy to .env and fill in.
# NO secrets are committed. .env is gitignored.
# ─────────────────────────────────────────────────────────────

# ── Postgres 16 + pgvector ≥ 0.8 ──────────────────────────────
POSTGRES_USER=arnfar
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=arnfar
POSTGRES_HOST=localhost
# If the host already runs a native Postgres on 5432, use 5433 here (and in DATABASE_URL).
POSTGRES_PORT=5432
# Consumed by rag-api (Bun) running on the HOST, talking to the container.
# The APPLICATION connects as an unprivileged role. This is not cosmetic: PostgreSQL
# exempts SUPERUSER and BYPASSRLS roles from row security, so the tenant-isolation
# policies in migration 0003 do nothing while the app connects as the cluster owner.
# Create the role with `bun run db:app-role`, then use it here.
DATABASE_URL=postgres://arnfar_app:change-me-locally@localhost:5432/arnfar

# The OWNER connection. Used only by migrations and by db:app-role, never by the service.
# rag-api refuses to start in production when its own connection can bypass RLS.
ADMIN_DATABASE_URL=postgres://arnfar:change-me-locally@localhost:5432/arnfar
APP_DB_ROLE=arnfar_app
APP_DB_PASSWORD=change-me-locally

# ── Ollama (runs on the HOST, never called from Next.js) ──────
OLLAMA_BASE_URL=http://localhost:11434
# SEA-LION (Gemma-based, SE-Asian-tuned) is the Lao generator; qwen3 is the
# cross-family judge for eval. Both must be pulled with `ollama pull`.
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_GEN_MODEL=hf.co/aisingapore/Gemma-SEA-LION-v3-9B-IT-GGUF:latest
OLLAMA_GEN_MODEL_ALT=qwen3:8b

# ── Answer verification ───────────────────────────────────────────────────────────────
# Every delivered chat answer is re-read by a DIFFERENT model family, which checks that
# each claim is supported by the chunks it cited. The verdict becomes a badge under the
# answer; it never rewrites the answer. Runs as a background job — the reader never waits.
#
# DEFAULT OFF, measured. Neither judge is trustworthy on this hardware yet:
#   qwen3:8b            correct (5/5, quoting the right source) but 6.7 GB CPU-resident
#                       next to the generator OOM-killed llama-server mid-answer.
#   qwen2.5:3b-instruct memory-safe but scored that SAME correct answer 1/5 "unsupported".
# CLAUDE.md decision 4 wants ~20 human labels of calibration first. Until then a badge that
# cries wolf is worse than no badge. Use POST /chat/messages/:id/verify for one-off checks.
CHAT_VERIFY_ANSWERS=false
# The judge. Must not be the generator's family, or it grades itself generously
# (CLAUDE.md decision 4): Qwen is not Gemma-based like SEA-LION.
#
# 3B rather than 8B is a MEMORY decision. The judge runs CPU-only (below), so its weights
# sit in system RAM next to the generator's. On a 16 GB box, a CPU-resident qwen3:8b
# (6.7 GB) alongside SEA-LION (6.8 GB), bge-m3, Postgres and the sidecars exhausted swap
# and the kernel OOM-killed llama-server mid-answer. Raise this only with RAM to spare.
OLLAMA_VERIFY_MODEL=qwen2.5:3b-instruct
# Keep the judge off the GPU. An 8 GB card holds ONE 8-9B model: letting the judge on
# evicts the generator, so the next question pays a 5-15s reload. `ollama ps` shows the
# judge at 100% CPU while the generator keeps the card.
OLLAMA_VERIFY_ON_CPU=true
# Unload the judge as soon as it answers. Ollama's default is 5 minutes of held RAM to
# serve one background check that already finished.
OLLAMA_VERIFY_KEEP_ALIVE=0s
# Lao word/sentence correction (/studio/lao-check rewrite): LaoNLP + glossary find the
# defects, this model applies them as a minimal edit. gemma-3n-laos is a Lao-fine-tuned
# Gemma 3n — pull with `ollama pull gemma-3n-laos:Q4_K_M`.
OLLAMA_LAO_CORRECT_MODEL=gemma-3n-laos:Q4_K_M
# Cap embedding concurrency so the ingest path never starves the chat path.
OLLAMA_EMBED_CONCURRENCY=4
# Generation context window (tokens, prompt + answer). SEA-LION v3 (Gemma2) max is
# 8192. Ollama's own default is VRAM-based (4096 on an 8GB card) and it silently
# drops the START of the prompt — system persona, glossary, first sources — when the
# RAG prompt overflows. Lower only if generation becomes too slow on small VRAM.
OLLAMA_NUM_CTX=8192

# ── Python sidecars (containerized, :7731 / :7732) ────────────
LAO_NLP_URL=http://localhost:7731
DOCX_EXTRACTOR_URL=http://localhost:7732
# Build lao-nlp with the bge-reranker-v2-m3 cross-encoder (~2.5GB: torch + weights, baked
# into the image so the runtime stays offline). Off by default — /rerank answers 503 and
# nothing on the ingest path needs it. Set to 1 and rebuild to unlock the
# `hybrid-rrf+rerank` eval arm:  LAO_NLP_RERANKER=1 docker compose up -d --build lao-nlp
LAO_NLP_RERANKER=0

# ── rag-api (Bun + Elysia) ────────────────────────────────────
RAG_API_PORT=7730
# Browser origins allowed to call rag-api. An allowlist, not "*" — any origin that can
# reach this API can read the client's accounting data.
CORS_ORIGINS=http://localhost:3000
# debug | info | warn | error. "debug" also attaches stack traces to logged errors.
LOG_LEVEL=info
# pretty | json. Defaults to pretty on a TTY, json otherwise (containers, log files).
LOG_FORMAT=pretty
RAG_API_URL=http://localhost:7730

# ── Object storage (Phase 0 decision: local filesystem volume) ─
# Swappable to S3/MinIO later behind the storage interface.
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./storage

# ── Web (Next.js 15) ──────────────────────────────────────────
# The browser talks ONLY to rag-api. Never to Ollama or the sidecars.
# ── Serving over your network (see README "Serving the site over your network") ──
# rag-api has NO authentication. Anything that can reach the port can read every ledger
# it serves, so the bind address is the only thing standing between the data and the
# network. Loopback by default; 0.0.0.0 serves other machines.
RAG_API_HOST=127.0.0.1
# Browser origins allowed to call the API. When serving over a LAN the origin is whatever
# address the visitor typed, and DHCP changes it — this accepts any private-range origin
# instead of pinning one. Convenience for browsers, not a security control: CORS is
# enforced by the browser and does nothing about curl.
CORS_ALLOW_PRIVATE_NETWORK=false
# Interface Next binds. Next's own default is all interfaces.
WEB_HOST=0.0.0.0
WEB_PORT=3000
# Leave EMPTY to derive the API address from whatever address the site was opened on —
# that is what lets one build serve localhost and a LAN IP. Set it only for a deployment
# behind a fixed hostname or reverse proxy.
NEXT_PUBLIC_RAG_API_URL=

# ── Dev tenant (single-tenant seed; columns/filters exist everywhere) ─
# UUIDv7 values. Regenerate for your own environment.
DEV_HF_ID=018f9a1e-7c00-7000-8000-000000000001
DEV_COMPANY_ID=018f9a1e-7c00-7000-8000-000000000002
DEV_BRANCH_ID=018f9a1e-7c00-7000-8000-000000000003

# Real ERP database (read-only role; see docs/ERP-INTEGRATION.md).
# Unset = bundled demo data.
# ERP_DATABASE_URL=postgres://arnfar_ai:password@erp-host:5432/your_erp_db

# Demo mode re-seeds its fixtures whenever erp.customer is empty, so deleting those
# rows does not remove them. Set false to keep a deliberately emptied ERP schema empty.
# ERP_DEMO_SEED=false
